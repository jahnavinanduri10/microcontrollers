void printmsg(char *msg) {
	for (uint32_t i = 0; i < strlen(msg); i++) {
		HAL_UART_Transmit(&huart2, (uint8_t*) &msg[i], 1, 100);
	}
}

int main(void) {
	/* Reset of all peripherals, Initializes the Flash interface and the Systick. */
	HAL_Init();
	/* Configure the system clock */
	SystemClock_Config();
	/* Initialize all configured peripherals */
	MX_GPIO_Init();
	MX_SPI1_Init();
	MX_USART2_UART_Init();
	MX_TIM3_Init();

	W25Q_EraseSector(0);

	sprintf(user_msg, "\r\nData logger\n\r");
	printf(user_msg);

	// create queue
	flash_queue = xQueueCreate(10, 3);
	alert_queue = xQueueCreate(10, 3);

	if (flash_queue != NULL && alert_queue != NULL) {
		// creating tasks
		xTaskCreate(vTask1_sensor, "TASK1-SENSOR", 500, NULL, 1, &xTaskHandle1);

		xTaskCreate(vTask2_flash, "TASK2-FLASH", 500, NULL, 2, &xTaskHandle2);

		xTaskCreate(vTask3_alert, "TASK3-ALERT", 500, NULL, 2, &xTaskHandle3);

		xTaskCreate(vTask4_uart, "TASK4-UART", 500, NULL, 3, &xTaskHandle4);

		vTaskStartScheduler();
	} else {
		sprintf(user_msg, "Queue creation failed\n\r");
		printmsg(user_msg);
	}

	while (1) {
		/* USER CODE END WHILE */

		/* USER CODE BEGIN 3 */
	}

}

void vTask1_sensor(void *params)
{
	uint16_t distance;
	// read the ultrasonic data
	while(1)
	{
		distance = read_distance();

		// send the data to queue
		xQueueSend(flash_queue,&distance,portMAX_DELAY);
		xQueueSend(alert_queue,&distance,portMAX_DELAY);

		// delay for 100ms
		vTaskDelay(pdMS_TO_TICKS(100));
	}
}

void vTask2_flash(void *params)
{
	uint16_t distance;
	while(1)
	{
		// read the data from queue
		if(xQueueReceive(flash_queue, &distance, portMAX_DELAY) == pdPASS)
		{
			if(log_count >= MAX_LOGS)
			{
				// erase sector
				W25Q_EraseSector(0);
				address = 0;
				log_count = 0;
			}
			// store the data to flash
			W25Q_Write(address, (uint8_t*)distance, 20);
			address += sizeof(distance);
			log_count++;
		}
	}
}

void vTask3_alert(void *params)
{
	uint16_t distance;
	while(1)
	{
		// read data from alert queue
		if(xQueueReceive(alert_queue,&distance, portMAX_DELAY) == pdPASS)
		{
			if(distance < THRESHOLD)
			{
				HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, SET);
			}
			else
			{
				HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, RESET);
			}
		}
	}
}

void vTask4_uart(void *params)
{
	uint16_t distance;
	while(1)
	{
		for(uint32_t addr = 0;addr < address; addr += sizeof(distance))
		{
			W25Q_Read(addr, (uint16_t*)&distance, sizeof(distance));
			sprintf(user_msg,"Distance: %d cm\r\n",distance);
			printmsg(user_msg);
		}

		vTaskDelay(pdMS_TO_TICKS(1000));
	}
}


int read_distance(void)
{
	uint32_t duration = 0;
	uint32_t timeout;

	//  Send TRIG pulse
	HAL_GPIO_WritePin(TRIG_PORT, TRIG_PIN, GPIO_PIN_RESET);
	delay_us(2);

	HAL_GPIO_WritePin(TRIG_PORT, TRIG_PIN, GPIO_PIN_SET);
	delay_us(10);

	HAL_GPIO_WritePin(TRIG_PORT, TRIG_PIN, GPIO_PIN_RESET);

	//  Wait for ECHO HIGH
	timeout = 30000;
	while(HAL_GPIO_ReadPin(ECHO_PORT, ECHO_PIN) == GPIO_PIN_RESET)
	{
		   if(--timeout == 0) return -1;
	}

	//  Start timer
	__HAL_TIM_SET_COUNTER(&htim3, 0);


	// Wait for ECHO LOW
	timeout = 30000;
	while(HAL_GPIO_ReadPin(ECHO_PORT, ECHO_PIN) == GPIO_PIN_SET)
	{
		if(__HAL_TIM_GET_COUNTER(&htim3) > 30000) break;
	}
	//  Read duration
	duration = __HAL_TIM_GET_COUNTER(&htim3);

	//  Convert to distance
	distance = duration / 58;
	return distance;
}

void rtos_delay(uint32_t delay_in_ms)
{
	uint32_t current_tick_count = xTaskGetTickCount();

	uint32_t delay_in_ticks = (delay_in_ms * configTICK_RATE_HZ) / 1000;

	while(xTaskGetTickCount() < (current_tick_count + delay_in_ticks));
}

